---
import { ClientRouter } from 'astro:transitions';
import { FontConfig, SiteLanguage, SiteTitle } from '~/config';

export interface Props {
	title?: string;
	description?: string;
	socialImage?: string;
	rootClass?:
		| Iterable<
				string | Record<string, boolean> | string[] | false | null | undefined
		  >
		| string;
	bodyClass?:
		| Iterable<
				string | Record<string, boolean> | string[] | false | null | undefined
		  >
		| string;
}
const { title, description, socialImage, rootClass, bodyClass } = Astro.props;
const socialImg = new URL(socialImage ?? '/og.png', Astro.url).href;
const fontFaceStyles = `
	@font-face {
		font-family: '${FontConfig.latinFamily}';
		src: url('${FontConfig.latinPath}') format('woff2');
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		size-adjust: 102%;
	}
	@font-face {
		font-family: '${FontConfig.brandEnFamily}';
		src: url('${FontConfig.brandEnPath}') format('woff');
		font-style: normal;
		font-weight: 400;
		font-display: block;
	}
	@font-face {
		font-family: '${FontConfig.brandZhFamily}';
		src: url('${FontConfig.brandZhPath}') format('woff');
		font-style: normal;
		font-weight: 400;
		font-display: block;
	}
`;
---

<html lang={SiteLanguage} class:list={rootClass}>
	<head>
		<meta charset="utf-8" />
		<link rel="canonical" href={Astro.url.href} />
		<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
		<meta http-equiv="x-ua-compatible" content="ie=edge" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f6fa" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1b212b" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href={FontConfig.latinPath}
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link rel="stylesheet" href={FontConfig.cjkSerifCssPath} />
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="alternate" type="application/rss+xml" title={`${SiteTitle} RSS Feed`} href="/rss.xml" />
		<link rel="sitemap" type="application/xml" title={`${SiteTitle} site map`} href="/sitemap-index.xml" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:title" content={title} />
		<meta property="og:type" content="website" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImg} />
		<meta property="og:site_name" content={SiteTitle} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={Astro.url.href} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImg} />
		<ClientRouter />

		<script is:inline>
			// Blocking theme init — runs before first paint to prevent FOUC.
			(function () {
				try {
					var raw = localStorage.getItem('theme');
					var resolved =
						raw === '"dark"' || raw === '"light"'
							? raw.slice(1, -1)
							: raw === 'dark' || raw === 'light'
								? raw
								: window.matchMedia('(prefers-color-scheme: dark)').matches
									? 'dark'
									: 'light';
					document.documentElement.classList.add(resolved);
				} catch (_) {}
			})();
		</script>

		<style is:global set:html={fontFaceStyles} />
		<style is:global>
			@tailwind base;
			@layer base {
				*:hover,
				*:focus,
				*:active {
					@apply motion-safe:transition;
				}

				:root {
					@apply scroll-smooth antialiased;
					color-scheme: light;

					/* Colors drawn from cafe manager portrait: apron, fur, shirt, leather */
					--color-bg: #f4f6fa;
					--color-surface: #ffffff;
					--color-surface-2: #e8edf5;
					--color-text: #1f2630;
					--color-muted: #596270;
					--color-border: #d0d7e2;
					--color-dots: #a9b4c4;
					--color-accent: #2a63b6;
					--color-accent-soft: rgba(42, 99, 182, 0.1);
					--color-leather: #b47636;
					--color-leather-ink: #86511c;
					--color-shadow-rgb: 31 38 48;

					--font-menu: 'Allo', 'LXGW Neo ZhiSong', 'Songti SC', 'SimSun', serif;
					--font-ui: 'Allo', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', system-ui, sans-serif;

					--radius-shell: 1rem;
					--radius-card: 0.75rem;
					--radius-soft: 0.65rem;
					--radius-button: 999px;
					--radius-chip: 999px;
					--radius-media: 0.5rem;
					--motion-gentle: 180ms cubic-bezier(0.23, 1, 0.32, 1);
					--motion-lift: 240ms cubic-bezier(0.23, 1, 0.32, 1);

					--pagefind-ui-scale: 0.92;
					--pagefind-ui-primary: var(--color-text);
					--pagefind-ui-text: var(--color-muted);
					--pagefind-ui-background: var(--color-bg);
					--pagefind-ui-border: var(--color-border);
					--pagefind-ui-tag: var(--color-surface-2);
					--pagefind-ui-font: var(--font-ui);
				}

				:root:is(.dark) {
					color-scheme: dark;

					--color-bg: #1b212b;
					--color-surface: #222a36;
					--color-surface-2: #283140;
					--color-text: #e7eaf0;
					--color-muted: #9ba5b3;
					--color-border: #353e4c;
					--color-dots: #556173;
					--color-accent: #86b4f2;
					--color-accent-soft: rgba(134, 180, 242, 0.14);
					--color-leather: #d6a066;
					--color-leather-ink: #e2b680;
					--color-shadow-rgb: 10 14 20;

					--pagefind-ui-primary: var(--color-text);
					--pagefind-ui-text: var(--color-muted);
					--pagefind-ui-background: var(--color-surface);
					--pagefind-ui-border: var(--color-border);
					--pagefind-ui-tag: var(--color-surface-2);
				}

				html {
					-webkit-tap-highlight-color: transparent;
					-webkit-text-size-adjust: 100%;
				}

				body {
					min-height: 100dvh;
					background: var(--color-bg);
					color: var(--color-text);
					font-family: var(--font-menu);
					font-size: 1.0625rem;
					line-height: 1.75;
					font-variant-numeric: tabular-nums;
					font-feature-settings: 'tnum' 1, 'ss03' 1, 'cv01' 1;
					font-variation-settings: 'ROND' 0;
					font-synthesis-weight: none;
				}

				h1,
				h2,
				h3,
				h4 {
					font-weight: 520;
					font-synthesis-weight: none;
				}

				:focus-visible {
					outline: 2px solid var(--color-accent);
					outline-offset: 3px;
					border-radius: 4px;
				}

				a {
					color: var(--color-accent);
					text-decoration-thickness: 1px;
					text-underline-offset: 0.22em;
					transition: color var(--motion-gentle);
				}

				::selection {
					background: color-mix(in srgb, var(--color-accent) 22%, var(--color-bg));
					color: var(--color-text);
				}

				/* Shared menu typography primitives */
				.menu-sec-head {
					display: flex;
					align-items: baseline;
					justify-content: space-between;
					gap: 1rem;
					padding: 0.45rem 0;
					border-top: 2px solid var(--color-text);
					border-bottom: 1px solid var(--color-border);
				}

				.menu-sec-title {
					display: inline-flex;
					align-items: baseline;
					gap: 0.55rem;
					margin: 0;
					font-size: 1.25rem;
					line-height: 1.35;
					font-weight: 520;
					color: var(--color-text);
				}

				.menu-sec-num {
					font-family: var(--font-ui);
					font-size: 0.85rem;
					font-weight: 500;
					color: var(--color-muted);
					letter-spacing: 0.02em;
				}

				.menu-sec-note {
					font-family: var(--font-ui);
					font-size: 0.8125rem;
					color: var(--color-muted);
					white-space: nowrap;
				}

				.prose pre {
					scrollbar-color: var(--color-border) transparent;
				}
			}

			:root:is(.dark) .astro-code,
			:root:is(.dark) .astro-code span {
				color: var(--shiki-dark) !important;
				background-color: var(--shiki-dark-bg) !important;
				font-style: var(--shiki-dark-font-style) !important;
				font-weight: var(--shiki-dark-font-weight) !important;
				text-decoration: var(--shiki-dark-text-decoration) !important;
			}

			@tailwind components;
			@tailwind utilities;
		</style>
	</head>
	<body class:list={bodyClass}>
		<slot />
	</body>
</html>
