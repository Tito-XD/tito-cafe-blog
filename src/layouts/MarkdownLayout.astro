---
import type { CollectionEntry } from 'astro:content';
import Comments from '~/components/Comments.astro';
import MenuPostRow from '~/components/MenuPostRow.astro';
import { Hide, type HideElements } from '~/config';
import type { PostHideElements } from '~/content.config';
import type { PostEntry } from '~/utils/collection';
import { formatDotDate, getDisplayTags } from '~/utils/readingTime';
import ScaffoldLayout from './ScaffoldLayout.astro';
import 'katex/dist/katex.css';

type Props = CollectionEntry<'posts'>['data'] & {
	currentNav?: string;
	socialImage?: string;
	nearPosts?: PostEntry[];
};

const {
	title,
	date,
	lastmod,
	tags,
	readingTime,
	hide,
	nearPosts = [],
} = Astro.props;

const show = (key: string) =>
	!(
		Hide.includes(key as HideElements) ||
		hide?.includes(key as PostHideElements)
	);

const showDate = Boolean(date && show('date'));
const dateStr = formatDotDate(date);
const lastmodStr = formatDotDate(lastmod);
const showLastmod = Boolean(
	lastmod && show('lastmod') && lastmodStr && lastmodStr !== dateStr,
);
const showReadingTime = Boolean(readingTime && show('readingTime'));
const displayTags = show('tags') ? getDisplayTags(tags) : [];
---

<ScaffoldLayout {...Astro.props}>
	<article class="post-page">
		<p class="post-back">
			<a href="/blog">← 全部文章</a>
		</p>

		{title && show('title') && <h1 class="post-title">{title}</h1>}

		{
			(showDate || showLastmod || showReadingTime) && (
				<p class="post-meta">
					{showDate && date && (
						<time datetime={date.toISOString()}>{dateStr}</time>
					)}
					{showLastmod && lastmod && (
						<span>
							（更新于{' '}
							<time datetime={lastmod.toISOString()}>{lastmodStr}</time>）
						</span>
					)}
					{showDate && showReadingTime && ' · '}
					{showReadingTime && readingTime && <span>{readingTime.text}</span>}
				</p>
			)
		}

		<div class="post-prose prose max-w-none dark:prose-invert">
			<slot />
		</div>

		{
			displayTags.length > 0 && (
				<ul class="post-tags" aria-label="文章标签">
					{displayTags.map((tag) => (
						<li>
							<a href={`/blog?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
						</li>
					))}
				</ul>
			)
		}

		{
			nearPosts.length > 0 && (
				<section class="post-near" aria-labelledby="near-posts-h">
					<div class="menu-sec-head">
						<h2 class="menu-sec-title" id="near-posts-h">
							<span>接着看</span>
						</h2>
						<span class="menu-sec-note">读完大约</span>
					</div>
					<ul class="post-near__rows">
						{nearPosts.map((near) => (
							<MenuPostRow post={near} />
						))}
					</ul>
				</section>
			)
		}

		{
			show('comments') && (
				<div class="post-comments">
					<Comments />
				</div>
			)
		}
	</article>
</ScaffoldLayout>

<style>
	.post-page {
		max-width: 40rem;
		margin-inline: auto;
		padding-block: 1.25rem 3.25rem;
	}

	.post-back {
		margin: 0 0 0.75rem;
		font-size: 0.95rem;
	}

	.post-back a {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		color: var(--color-muted);
		text-decoration: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.post-back a:hover {
			color: var(--color-accent);
		}
	}

	.post-title {
		margin: 0;
		font-size: clamp(1.9rem, 5.2vw, 2.6rem);
		line-height: 1.3;
		font-weight: 520;
		text-wrap: balance;
	}

	.post-meta {
		margin: 0.65rem 0 0;
		font-family: var(--font-ui);
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.post-prose {
		margin-top: 2rem;
		color: var(--color-text);
		font-size: 1.08rem;
		line-height: 1.95;
	}

	.post-prose :global(h1),
	.post-prose :global(h2),
	.post-prose :global(h3),
	.post-prose :global(h4),
	.post-prose :global(h5),
	.post-prose :global(h6) {
		color: var(--color-text);
		font-weight: 520;
		line-height: 1.4;
	}

	.post-prose :global(strong) {
		color: var(--color-text);
		font-weight: 600;
	}

	.post-prose :global(a) {
		color: var(--color-accent);
	}

	.post-prose :global(p) {
		text-wrap: pretty;
	}

	.post-prose :global(blockquote) {
		border-left: 2px solid var(--color-leather);
		color: var(--color-muted);
		font-style: normal;
	}

	.post-prose :global(hr) {
		border-color: var(--color-border);
	}

	.post-prose :global(pre) {
		border-radius: 0.45rem;
		border: 1px solid var(--color-border);
		background: var(--color-surface-2) !important;
	}

	.post-prose :global(img),
	.post-prose :global(video),
	.post-prose :global(iframe) {
		border-radius: 0.45rem;
	}

	.post-prose :global(p code) {
		border-radius: 0.25rem;
		background: var(--color-surface-2);
		padding: 0.18rem 0.35rem;
		font-size: 0.9em;
	}

	.post-prose :global(p code)::before,
	.post-prose :global(p code)::after {
		content: none;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1rem;
		margin: 2.25rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.95rem;
	}

	.post-tags a {
		color: var(--color-muted);
		text-decoration: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.post-tags a:hover {
			color: var(--color-accent);
		}
	}

	.post-near {
		margin-top: 3rem;
	}

	.post-near__rows {
		margin: 0.35rem 0 0;
		padding: 0;
		list-style: none;
	}

	.post-comments {
		margin-top: 2.75rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
	}
</style>

<script>
	function setupCopyButtons() {
		const windowWithCleanup = window as Window & {
			__copyButtonsCleanup?: () => void;
		};
		windowWithCleanup.__copyButtonsCleanup?.();

		const handleCopyClick = async (event: MouseEvent) => {
			const target = event.target;
			if (!(target instanceof Element)) {
				return;
			}

			const copyButton = target.closest('.prose button.copy');
			if (!(copyButton instanceof HTMLElement)) {
				return;
			}

			const code = copyButton.nextElementSibling?.children[0];
			if (!code) {
				return;
			}

			await navigator.clipboard.writeText(code.textContent ?? '');
			copyButton.setAttribute('aria-pressed', 'true');
			setTimeout(() => {
				copyButton.setAttribute('aria-pressed', 'false');
			}, 700);
		};

		document.addEventListener('click', handleCopyClick);
		windowWithCleanup.__copyButtonsCleanup = () => {
			document.removeEventListener('click', handleCopyClick);
		};
	}

	setupCopyButtons();
	document.addEventListener('astro:page-load', setupCopyButtons);
</script>
