---
interface Props {
	currentNav?: string;
}
const { currentNav } = Astro.props;

const navs = [
	{ key: 'Blog', label: '文章', href: '/blog' },
	{ key: 'Touls', label: 'Touls', href: '/touls' },
	{ key: 'Friends', label: '邻座', href: '/friends' },
	{ key: 'About', label: '关于', href: '/about' },
];
---

<nav class="site-nav" aria-label="主导航">
	<ul class="site-nav__list">
		{
			navs.map((nav) => (
				<li>
					<a
						href={nav.href}
						class="site-nav__link"
						aria-current={currentNav === nav.key ? 'page' : undefined}
					>
						{nav.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.site-nav__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 1.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__link {
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		color: var(--color-text);
		text-decoration: none;
		font-size: 1.0625rem;
		transition: color var(--motion-gentle);
	}

	.site-nav__link[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--color-leather);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.42em;
	}

	@media (hover: hover) and (pointer: fine) {
		.site-nav__link:hover {
			color: var(--color-accent);
		}
	}

	@media (min-width: 48rem) {
		.site-nav__list {
			gap: 0 1.85rem;
		}
	}
</style>
