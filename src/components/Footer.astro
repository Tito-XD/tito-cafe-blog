---
import { FooterDescription, Hide } from '~/config';
---

<footer class="site-foot">
	<div class="site-foot__row">
		{
			!Hide.includes('footerDescription') && (
				<span>{FooterDescription}</span>
			)
		}
		<span>
			&copy; {new Date().getFullYear()} 头头咖啡屋 / Tito&apos;s Cafe ·{' '}
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
	<p class="site-foot__colophon">
		Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> ·
		字体使用 <a href="https://github.com/lxgw/LxgwNeoZhiSong" target="_blank" rel="noopener">霞鹜新致宋</a>（IPA Font License 1.0）与 <a href="https://allo.joshpuckett.me" target="_blank" rel="noopener">Allo</a>（SIL OFL 1.1）
	</p>
</footer>

<style>
	.site-foot {
		margin-top: 2.5rem;
		padding-block: 1.4rem max(2rem, env(safe-area-inset-bottom));
		border-top: 1px solid var(--color-border);
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.site-foot__row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.35rem 1.5rem;
	}

	.site-foot__colophon {
		margin: 0.5rem 0 0;
		font-family: var(--font-ui);
		font-size: 0.78rem;
		line-height: 1.6;
		opacity: 0.85;
	}

	.site-foot a {
		color: inherit;
		text-decoration-color: var(--color-border);
	}

	@media (hover: hover) and (pointer: fine) {
		.site-foot a:hover {
			color: var(--color-accent);
			text-decoration-color: var(--color-accent);
		}
	}
</style>
