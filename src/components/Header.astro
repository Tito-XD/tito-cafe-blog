---
import { Icon } from 'astro-icon/components';
import { Hide } from '~/config';
import HeaderBrand from './HeaderBrand.astro';
import Nav from './Nav.astro';
import ThemeToggler from './ThemeToggler.astro';

interface Props {
	currentNav?: string;
}

const { currentNav } = Astro.props;
---

<header class="site-top">
	<HeaderBrand />
	<Nav currentNav={currentNav} />
	<div class="site-top__actions">
		{
			!Hide.includes('search') && (
				<a
					href="/search"
					class="site-top__icon-btn"
					aria-current={currentNav === 'Search' ? 'page' : undefined}
					aria-label="搜索文章"
					title="搜索"
				>
					<Icon name="ri:search-line" class="size-[1.1rem]" aria-hidden="true" />
				</a>
			)
		}
		{!Hide.includes('themeToggler') && <ThemeToggler />}
	</div>
</header>

<style>
	.site-top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.35rem 1rem;
		padding-block: max(1rem, env(safe-area-inset-top)) 0.75rem;
	}

	.site-top :global(.site-nav) {
		grid-column: 1 / -1;
	}

	.site-top__actions {
		grid-row: 1;
		grid-column: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.site-top__icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.3rem;
		height: 2.3rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
		transition:
			border-color var(--motion-gentle),
			color var(--motion-gentle);
	}

	.site-top__icon-btn[aria-current='page'] {
		border-color: var(--color-leather);
		color: var(--color-leather-ink);
	}

	@media (hover: hover) and (pointer: fine) {
		.site-top__icon-btn:hover {
			border-color: var(--color-leather);
			color: var(--color-accent);
		}
	}

	@media (min-width: 48rem) {
		.site-top {
			grid-template-columns: auto 1fr auto;
			gap: 0.35rem 1.5rem;
			padding-block: 1.5rem 1rem;
		}

		.site-top :global(.site-nav) {
			grid-row: 1;
			grid-column: 2;
			justify-self: end;
		}

		.site-top__actions {
			grid-column: 3;
			gap: 0.6rem;
		}
	}
</style>
