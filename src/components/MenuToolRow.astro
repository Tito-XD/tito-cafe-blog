---
import type { ToolLink } from '~/data/tools';

interface Props {
	tool: ToolLink;
}

const { tool } = Astro.props;
const isExternal = tool.href.startsWith('http');
---

<li class="tool-row">
	<div class="tool-row__top">
		<span class="tool-row__name">
			<a
				href={tool.href}
				target={isExternal ? '_blank' : undefined}
				rel={isExternal ? 'noopener' : undefined}
			>
				{tool.title}
			</a>
		</span>
		<span class="tool-row__dots" aria-hidden="true"></span>
		{tool.tag && <span class="tool-row__tag">{tool.tag}</span>}
	</div>

	<div class="tool-row__sub">
		<span class="tool-row__desc">{tool.description}</span>
		{tool.externalHost && <span class="tool-row__host">{tool.externalHost}</span>}
	</div>

	{
		tool.subLinks && tool.subLinks.length > 0 && (
			<div class="tool-row__subs">
				{tool.subLinks.map((sub) => {
					const subExt = sub.href.startsWith('http');
					return (
						<a
							href={sub.href}
							target={subExt ? '_blank' : undefined}
							rel={subExt ? 'noopener' : undefined}
						>
							{sub.label}
						</a>
					);
				})}
			</div>
		)
	}
</li>

<style>
	.tool-row {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.16rem;
		min-width: 0;
		padding-block: 0.65rem;
	}

	.tool-row__top {
		display: grid;
		grid-template-columns: minmax(0, auto) minmax(0.75rem, 1fr) auto;
		align-items: baseline;
		column-gap: 0.5rem;
		min-width: 0;
	}

	.tool-row__name {
		min-width: 0;
		font-size: 1.12rem;
		font-weight: 520;
		line-height: 1.48;
		overflow-wrap: anywhere;
	}

	.tool-row__name a {
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--motion-gentle);
	}

	.tool-row__name a::after {
		content: '';
		position: absolute;
		inset: 0 -0.4rem;
		border-radius: 0.375rem;
	}

	.tool-row__name a:focus-visible {
		outline: none;
	}

	.tool-row__name a:focus-visible::after {
		outline: 2px solid var(--color-accent);
	}

	.tool-row__dots {
		min-width: 0.75rem;
		height: 0;
		border-bottom: 2px dotted var(--color-dots);
		transform: translateY(-0.22em);
		transition: border-color var(--motion-gentle);
	}

	.tool-row__tag {
		justify-self: end;
		white-space: nowrap;
		font-size: 0.98rem;
	}

	.tool-row__sub {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.1rem 0.75rem;
		min-width: 0;
	}

	.tool-row__desc {
		min-width: 0;
		flex: 1 1 11rem;
		color: var(--color-muted);
		font-size: 0.94rem;
		line-height: 1.58;
		overflow-wrap: anywhere;
	}

	.tool-row__host {
		margin-left: auto;
		flex-shrink: 0;
		font-family: var(--font-ui);
		font-size: 0.8rem;
		color: var(--color-muted);
		white-space: nowrap;
	}

	.tool-row__subs {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
		font-size: 0.9rem;
		margin-top: 0.1rem;
	}

	.tool-row__subs a {
		display: inline-flex;
		align-items: center;
		min-height: 1.95rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.tool-row:hover .tool-row__name a {
			color: var(--color-accent);
		}

		.tool-row:hover .tool-row__dots {
			border-color: var(--color-leather);
		}
	}
</style>
