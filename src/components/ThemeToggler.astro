---
---

<button
	type="button"
	data-theme-toggle
	class="lamp-btn forced-colors:hidden"
	aria-label="关灯（切换到深色模式）"
	data-theme="light"
>
	<span class="lamp-btn__light">关灯</span>
	<span class="lamp-btn__dark">开灯</span>
</button>

<style>
	.lamp-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.35rem;
		padding: 0 0.85rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: none;
		color: var(--color-text);
		font: inherit;
		font-size: 0.95rem;
		line-height: 1;
		cursor: pointer;
		touch-action: manipulation;
		user-select: none;
		-webkit-user-select: none;
		transition:
			transform 140ms cubic-bezier(0.23, 1, 0.32, 1),
			border-color var(--motion-gentle),
			color var(--motion-gentle);
	}

	.lamp-btn:active {
		transform: scale(0.97);
	}

	.lamp-btn__dark {
		display: none;
	}

	:global(:root.dark) .lamp-btn__light,
	.lamp-btn[data-theme='dark'] .lamp-btn__light {
		display: none;
	}

	:global(:root.dark) .lamp-btn__dark,
	.lamp-btn[data-theme='dark'] .lamp-btn__dark {
		display: inline;
	}

	@media (hover: hover) and (pointer: fine) {
		.lamp-btn:hover {
			border-color: var(--color-text);
		}
	}
</style>

<script>
	import { theme } from '~/store';

	const themeToggleSelector = '[data-theme-toggle]';
	type ThemeToggleWindow = Window & {
		__themeToggleSubscribed?: boolean;
		__themeToggleMediaBound?: boolean;
	};

	const resolveTheme = (rawTheme: string) => {
		if (rawTheme === 'dark' || rawTheme === 'light') {
			return rawTheme;
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches
			? 'dark'
			: 'light';
	};

	const syncThemeButtons = (doc: Document, resolvedTheme: 'dark' | 'light') => {
		const buttons = Array.from(doc.querySelectorAll(themeToggleSelector));
		for (const button of buttons) {
			if (!(button instanceof HTMLButtonElement)) {
				continue;
			}
			button.setAttribute('data-theme', resolvedTheme);
			const label =
				resolvedTheme === 'dark'
					? '开灯（切换到浅色模式）'
					: '关灯（切换到深色模式）';
			button.setAttribute('aria-label', label);
			button.setAttribute('title', label);
		}
	};

	const applyTheme = (doc: Document, rawTheme: string) => {
		const resolvedTheme = resolveTheme(rawTheme);
		doc.documentElement.classList.remove('dark', 'light', 'os-default');
		doc.documentElement.classList.add(resolvedTheme);
		syncThemeButtons(doc, resolvedTheme);
		return resolvedTheme;
	};

	const bindToggle = (doc: Document) => {
		applyTheme(doc, theme.get());
		const buttons = Array.from(doc.querySelectorAll(themeToggleSelector));
		for (const button of buttons) {
			if (!(button instanceof HTMLButtonElement)) {
				continue;
			}
			button.onclick = () => {
				const currentTheme =
					button.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
				theme.set(currentTheme === 'dark' ? 'light' : 'dark');
			};
		}
	};

	const themeWindow = window as ThemeToggleWindow;
	if (!themeWindow.__themeToggleSubscribed) {
		theme.subscribe((newTheme) => {
			applyTheme(document, newTheme);
		});
		themeWindow.__themeToggleSubscribed = true;
	}

	bindToggle(document);
	document.addEventListener('astro:before-swap', (ev) =>
		bindToggle(ev.newDocument),
	);
	document.addEventListener('astro:page-load', () => bindToggle(document));

	if (!themeWindow.__themeToggleMediaBound) {
		window
			.matchMedia('(prefers-color-scheme: dark)')
			.addEventListener('change', () => {
				if (theme.get() === 'os-default') {
					applyTheme(document, 'os-default');
				}
			});
		themeWindow.__themeToggleMediaBound = true;
	}
</script>
