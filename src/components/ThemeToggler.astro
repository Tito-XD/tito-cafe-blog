---
---

<button
	type="button"
	data-theme-toggle
	class="lamp-btn forced-colors:hidden"
	aria-label="关灯（切换到深色模式）"
	title="关灯"
	data-theme="light"
>
	<!-- Lit cafe pendant lamp (shown in light mode) -->
	<svg
		class="lamp-icon lamp-icon--on"
		xmlns="http://www.w3.org/2000/svg"
		width="19"
		height="19"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.75"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M12 2v3" />
		<path d="M5.5 11.5a6.5 6.5 0 0 1 13 0Z" />
		<path d="M10 11.5a2 2 0 1 0 4 0" />
		<path class="lamp-rays" d="M12 16.5v2.5M7.5 15.2l-1.5 1.8M16.5 15.2l1.5 1.8" />
	</svg>

	<!-- Unlit night lamp with crescent (shown in dark mode) -->
	<svg
		class="lamp-icon lamp-icon--off"
		xmlns="http://www.w3.org/2000/svg"
		width="19"
		height="19"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.75"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M12 2v3" />
		<path d="M5.5 11.5a6.5 6.5 0 0 1 13 0Z" />
		<path d="M10 11.5a2 2 0 1 0 4 0" opacity="0.45" />
		<path class="lamp-moon" d="M14.5 16.2a3 3 0 1 1-3.2 3.2 2.4 2.4 0 0 0 3.2-3.2Z" />
	</svg>
</button>

<style>
	.lamp-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.3rem;
		height: 2.3rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-text);
		cursor: pointer;
		touch-action: manipulation;
		user-select: none;
		-webkit-user-select: none;
		transition:
			transform 140ms cubic-bezier(0.23, 1, 0.32, 1),
			border-color var(--motion-gentle),
			color var(--motion-gentle),
			background var(--motion-gentle);
	}

	.lamp-btn:active {
		transform: scale(0.95);
	}

	.lamp-rays {
		stroke: var(--color-leather);
	}

	.lamp-moon {
		stroke: var(--color-leather);
	}

	.lamp-icon--off {
		display: none;
	}

	:global(:root.dark) .lamp-icon--on,
	.lamp-btn[data-theme='dark'] .lamp-icon--on {
		display: none;
	}

	:global(:root.dark) .lamp-icon--off,
	.lamp-btn[data-theme='dark'] .lamp-icon--off {
		display: block;
	}

	@media (hover: hover) and (pointer: fine) {
		.lamp-btn:hover {
			border-color: var(--color-leather);
			color: var(--color-accent);
		}
	}
</style>

<script>
	import { theme } from '~/store';

	const themeToggleSelector = '[data-theme-toggle]';
	type ThemeToggleWindow = Window & {
		__themeToggleSubscribed?: boolean;
		__themeToggleMediaBound?: boolean;
	};

	const resolveTheme = (rawTheme: string) => {
		if (rawTheme === 'dark' || rawTheme === 'light') {
			return rawTheme;
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches
			? 'dark'
			: 'light';
	};

	const syncThemeButtons = (doc: Document, resolvedTheme: 'dark' | 'light') => {
		const buttons = Array.from(doc.querySelectorAll(themeToggleSelector));
		for (const button of buttons) {
			if (!(button instanceof HTMLButtonElement)) {
				continue;
			}
			button.setAttribute('data-theme', resolvedTheme);
			const shortTitle = resolvedTheme === 'dark' ? '开灯' : '关灯';
			const ariaLabel =
				resolvedTheme === 'dark'
					? '开灯（切换到浅色模式）'
					: '关灯（切换到深色模式）';
			button.setAttribute('aria-label', ariaLabel);
			button.setAttribute('title', shortTitle);
		}
	};

	const applyTheme = (doc: Document, rawTheme: string) => {
		const resolvedTheme = resolveTheme(rawTheme);
		doc.documentElement.classList.remove('dark', 'light', 'os-default');
		doc.documentElement.classList.add(resolvedTheme);
		syncThemeButtons(doc, resolvedTheme);
		return resolvedTheme;
	};

	const bindToggle = (doc: Document) => {
		applyTheme(doc, theme.get());
		const buttons = Array.from(doc.querySelectorAll(themeToggleSelector));
		for (const button of buttons) {
			if (!(button instanceof HTMLButtonElement)) {
				continue;
			}
			button.onclick = () => {
				const currentTheme =
					button.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
				theme.set(currentTheme === 'dark' ? 'light' : 'dark');
			};
		}
	};

	const themeWindow = window as ThemeToggleWindow;
	if (!themeWindow.__themeToggleSubscribed) {
		theme.subscribe((newTheme) => {
			applyTheme(document, newTheme);
		});
		themeWindow.__themeToggleSubscribed = true;
	}

	bindToggle(document);
	document.addEventListener('astro:before-swap', (ev) =>
		bindToggle(ev.newDocument),
	);
	document.addEventListener('astro:page-load', () => bindToggle(document));

	if (!themeWindow.__themeToggleMediaBound) {
		window
			.matchMedia('(prefers-color-scheme: dark)')
			.addEventListener('change', () => {
				if (theme.get() === 'os-default') {
					applyTheme(document, 'os-default');
				}
			});
		themeWindow.__themeToggleMediaBound = true;
	}
</script>
