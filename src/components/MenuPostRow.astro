---
import { type PostEntry, getPostRouteSlug } from '~/utils/collection';
import {
	formatDotDate,
	getDisplayTags,
	getPostMinutes,
	isAnnualPost,
} from '~/utils/readingTime';

interface Props {
	post: PostEntry;
	showAnnualBadge?: boolean;
}

const { post, showAnnualBadge = true } = Astro.props;
const slug = getPostRouteSlug(post);
const minutes = getPostMinutes(post);
const annual = showAnnualBadge && isAnnualPost(post);
const displayDate = post.data.date ?? post.data.lastmod;
const dateText = formatDotDate(displayDate);
const tags = getDisplayTags(post.data.tags);
const hasSub = Boolean(post.data.description || displayDate);
---

<li class="menu-row" data-tags={tags.join(',')}>
	<div class="menu-row__top">
		<span class="menu-row__name">
			<a href={`/posts/${slug}`}>{post.data.title}</a>
			{annual && <span class="menu-row__badge">年度</span>}
		</span>
		<span class="menu-row__dots" aria-hidden="true"></span>
		<span class="menu-row__price">{minutes} 分钟</span>
	</div>
	{
		hasSub && (
			<div class="menu-row__sub">
				{post.data.description && (
					<span class="menu-row__desc">{post.data.description}</span>
				)}
				{displayDate && (
					<time class="menu-row__meta" datetime={displayDate.toISOString()}>
						{dateText}
					</time>
				)}
			</div>
		)
	}
</li>

<style>
	.menu-row {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.16rem;
		min-width: 0;
		padding-block: 0.65rem;
	}

	.menu-row__top {
		display: grid;
		grid-template-columns: minmax(0, auto) minmax(0.75rem, 1fr) auto;
		align-items: baseline;
		column-gap: 0.5rem;
		min-width: 0;
	}

	.menu-row__name {
		min-width: 0;
		font-size: 1.12rem;
		font-weight: 520;
		line-height: 1.48;
		overflow-wrap: anywhere;
	}

	.menu-row__name a {
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--motion-gentle);
	}

	.menu-row__name a::after {
		content: '';
		position: absolute;
		inset: 0 -0.4rem;
		border-radius: 0.375rem;
	}

	.menu-row__name a:focus-visible {
		outline: none;
	}

	.menu-row__name a:focus-visible::after {
		outline: 2px solid var(--color-accent);
	}

	.menu-row__badge {
		display: inline-block;
		margin-left: 0.38rem;
		padding: 0 0.36rem;
		border: 1px solid var(--color-leather);
		border-radius: 4px;
		color: var(--color-leather-ink);
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: 400;
		line-height: 1.45;
		white-space: nowrap;
		vertical-align: 0.12em;
	}

	.menu-row__dots {
		min-width: 0.75rem;
		height: 0;
		border-bottom: 2px dotted var(--color-dots);
		transform: translateY(-0.22em);
		transition: border-color var(--motion-gentle);
	}

	.menu-row__price {
		justify-self: end;
		white-space: nowrap;
		font-size: 0.98rem;
	}

	.menu-row__sub {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.1rem 0.75rem;
		min-width: 0;
	}

	.menu-row__desc {
		min-width: 0;
		flex: 1 1 11rem;
		color: var(--color-muted);
		font-size: 0.94rem;
		line-height: 1.58;
		overflow-wrap: anywhere;
	}

	.menu-row__meta {
		margin-left: auto;
		flex-shrink: 0;
		font-family: var(--font-ui);
		font-size: 0.8rem;
		color: var(--color-muted);
		white-space: nowrap;
	}

	@media (hover: hover) and (pointer: fine) {
		.menu-row:hover .menu-row__name a {
			color: var(--color-accent);
		}

		.menu-row:hover .menu-row__dots {
			border-color: var(--color-leather);
		}
	}
</style>
