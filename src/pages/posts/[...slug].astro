---
import type { CollectionEntry } from 'astro:content';
import MarkdownLayout from '~/layouts/MarkdownLayout.astro';
import {
	type PostEntry,
	getPostRouteSlug,
	getPosts,
	render,
} from '~/utils/collection';

export async function getStaticPaths() {
	const allPosts = await getPosts();
	const visibleDesc = await getPosts(false, 'desc');
	const visibleIndexById = new Map(
		visibleDesc.map((entry, idx) => [entry.id, idx]),
	);

	return allPosts.map((post) => {
		const visIdx = visibleIndexById.get(post.id);
		const nearPosts: PostEntry[] = [];
		if (visIdx !== undefined) {
			if (visibleDesc[visIdx - 1]) {
				nearPosts.push(visibleDesc[visIdx - 1]);
			}
			if (visibleDesc[visIdx + 1]) {
				nearPosts.push(visibleDesc[visIdx + 1]);
			}
		}
		return {
			params: { slug: getPostRouteSlug(post) },
			props: { post, nearPosts },
		};
	});
}

type Props = {
	post: CollectionEntry<'posts'>;
	nearPosts: PostEntry[];
};

const { post, nearPosts } = Astro.props;
const socialImage = post.data.image?.src ?? `${Astro.url.pathname}.png`;
const { Content, remarkPluginFrontmatter } = await render(post);

if (typeof remarkPluginFrontmatter.date === 'string') {
	post.data.date = new Date(remarkPluginFrontmatter.date);
}
if (typeof remarkPluginFrontmatter.lastmod === 'string') {
	post.data.lastmod = new Date(remarkPluginFrontmatter.lastmod);
}
post.data.readingTime = remarkPluginFrontmatter.readingTime;
---

<MarkdownLayout
	{...post.data}
	nearPosts={nearPosts}
	socialImage={socialImage}
	currentNav="Blog"
>
	<Content />
</MarkdownLayout>
