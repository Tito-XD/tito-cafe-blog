---
import { Picture } from 'astro:assets';
import walkImg from '~/assets/tito_xd-walk-by-frankuwu.png';
import { Socials } from '~/config';
import ScaffoldLayout from '~/layouts/ScaffoldLayout.astro';

const socialRows: { key: string; label: string; note: string }[] = [
	{ key: 'xiaohongshu', label: '小红书', note: '日常碎片与照片' },
	{ key: 'x', label: 'X / Twitter', note: '@Tito_XD2333' },
	{ key: 'weibo', label: '微博', note: '偶尔冒泡' },
	{ key: 'bilibili', label: 'bilibili', note: '视频与动态' },
	{ key: 'telegram', label: 'Telegram', note: '@tito_xd' },
	{ key: 'mail', label: '电子邮件', note: 'titow.xd@outlook.com' },
	{ key: 'rss', label: 'RSS 订阅', note: '/rss.xml' },
].filter((item) => Boolean(Socials[item.key]?.url));
---

<ScaffoldLayout
	title="关于"
	description="关于头头咖啡屋与店长 Tito_XD"
	currentNav="About"
>
	<div class="paper-sheet paper-page about-page">
		<header class="about-hero">
			<div class="about-hero__copy">
				<h1 class="subpage-title">关于</h1>
				<p>我是 Tito_XD，本店的店长，也可以叫我头头。</p>
				<p>nameless nobody but still exploring this world.</p>
				<p>want to make 21 grams interesting.</p>
				<p>
					lives in Hubei, Wuhan and working as marketing, website maintainer.
				</p>
			</div>

			<figure class="about-hero__figure">
				<Picture
					class="about-hero__art"
					src={walkImg}
					formats={['avif', 'webp']}
					alt="Tito_XD 散步立绘 by Frank uwu"
					sizes="(max-width: 639px) 10rem, 12rem"
				/>
				<figcaption>
					立绘{' '}
					<a href="https://frankuwu.link/" target="_blank" rel="noopener">
						Frank uwu
					</a>
				</figcaption>
			</figure>
		</header>

		<section class="about-sec" aria-labelledby="about-links-h">
			<div class="menu-sec-head">
				<h2 class="menu-sec-title" id="about-links-h">
					<span class="menu-sec-num">01</span>
					<span>出没地点</span>
				</h2>
				<span class="menu-sec-note">联络与订阅</span>
			</div>

			<ul class="social-rows">
				{
					socialRows.map((item) => {
						const href = Socials[item.key].url;
						const isNewTab =
							href.startsWith('http') && !href.startsWith('mailto:');
						return (
							<li class="social-row">
								<span class="social-row__name">
									<a
										href={href}
										target={isNewTab ? '_blank' : undefined}
										rel={isNewTab ? 'noopener' : undefined}
									>
										{item.label}
									</a>
								</span>
								<span class="social-row__dots" aria-hidden="true" />
								<span class="social-row__note">{item.note}</span>
							</li>
						);
					})
				}
			</ul>
		</section>

		<section class="about-sec" aria-labelledby="about-colophon-h">
			<div class="menu-sec-head">
				<h2 class="menu-sec-title" id="about-colophon-h">
					<span class="menu-sec-num">02</span>
					<span>关于小店</span>
				</h2>
			</div>

			<div class="about-colophon">
				<p>
					这里用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 搭建，托管在 Netlify，主要放一些日常记录、年度回顾和顺手做的小工具。
				</p>
				<p>
					站内中文排版使用开源字体{' '}
					<a
						href="https://github.com/lxgw/LxgwNeoZhiSong"
						target="_blank"
						rel="noopener"
					>
						霞鹜新致宋
					</a>
					（遵循 IPA Font License 1.0 协议），西文与数字混排使用{' '}
					<a
						href="https://allo.joshpuckett.me"
						target="_blank"
						rel="noopener"
					>
						Allo
					</a>
					（遵循 SIL Open Font License 1.1 协议）。
				</p>
			</div>
		</section>
	</div>
</ScaffoldLayout>

<style>
	.subpage-title {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 5.2vw, 2.7rem);
		line-height: 1.25;
		font-weight: 520;
	}

	.about-hero {
		display: grid;
		gap: 1.5rem;
		align-items: center;
	}

	.about-hero__copy p {
		margin: 0;
	}

	.about-hero__copy p + p {
		margin-top: 0.45rem;
	}

	.about-hero__figure {
		margin: 0;
		justify-self: center;
		text-align: center;
	}

	.about-hero__figure :global(img),
	.about-hero__art {
		display: block;
		width: 9.5rem;
		height: auto;
		margin-inline: auto;
	}

	.about-hero__figure figcaption {
		margin-top: 0.4rem;
		font-family: var(--font-ui);
		font-size: 0.78rem;
		color: var(--color-muted);
	}

	@media (min-width: 40rem) {
		.about-hero {
			grid-template-columns: minmax(0, 1fr) 11rem;
			gap: 2rem;
		}

		.about-hero__figure :global(img),
		.about-hero__art {
			width: 100%;
		}
	}

	.about-sec {
		margin-top: 2.4rem;
	}

	.social-rows {
		margin: 0.4rem 0 0;
		padding: 0;
		list-style: none;
	}

	.social-row {
		position: relative;
		display: grid;
		grid-template-columns: max-content minmax(1.5rem, 1fr) max-content;
		align-items: baseline;
		column-gap: 0.6rem;
		padding-block: 0.58rem;
	}

	.social-row__name {
		font-size: 1.08rem;
		font-weight: 520;
	}

	.social-row__name a {
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--motion-gentle);
	}

	.social-row__name a::after {
		content: '';
		position: absolute;
		inset: 0 -0.45rem;
		border-radius: 0.375rem;
	}

	.social-row__name a:focus-visible {
		outline: none;
	}

	.social-row__name a:focus-visible::after {
		outline: 2px solid var(--color-accent);
	}

	.social-row__dots {
		height: 0;
		border-bottom: 2px dotted var(--color-dots);
		transform: translateY(-0.22em);
		transition: border-color var(--motion-gentle);
	}

	.social-row__note {
		font-family: var(--font-ui);
		font-size: 0.85rem;
		color: var(--color-muted);
		white-space: nowrap;
	}

	@media (hover: hover) and (pointer: fine) {
		.social-row:hover .social-row__name a {
			color: var(--color-accent);
		}

		.social-row:hover .social-row__dots {
			border-color: var(--color-leather);
		}
	}

	.about-colophon {
		margin-top: 0.9rem;
		color: var(--color-muted);
		font-size: 0.96rem;
	}

	.about-colophon p {
		margin: 0;
	}

	.about-colophon p + p {
		margin-top: 0.6rem;
	}
</style>
