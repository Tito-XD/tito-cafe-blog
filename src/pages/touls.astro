---
import MenuToolRow from '~/components/MenuToolRow.astro';
import { type ToolSection, tools } from '~/data/tools';
import ScaffoldLayout from '~/layouts/ScaffoldLayout.astro';

const sectionOrder: ToolSection[] = [
	'独立站点与企划',
	'站内写作与随记',
	'桌面周边与小测验',
];

const grouped = sectionOrder
	.map((sec, idx) => ({
		num: String(idx + 1).padStart(2, '0'),
		title: sec,
		items: tools.filter((t) => t.section === sec),
	}))
	.filter((g) => g.items.length > 0);
---

<ScaffoldLayout
	title="Touls"
	description="头头咖啡屋的小工具合集：图鉴、显像工坊、写作、光标与测验。"
	currentNav="Touls"
>
	<div class="paper-sheet paper-page touls-page">
		<header class="subpage-head">
			<h1 class="subpage-title">Touls</h1>
			<p class="subpage-lead">
				小工具角。名字是 Tools 的故意拼写版——毕竟是头头（Tito）的地盘。共收纳{' '}
				{tools.length} 项。
			</p>
		</header>

		<div class="touls-sections">
			{
				grouped.map((group) => (
					<section class="touls-sec">
						<div class="menu-sec-head">
							<h2 class="menu-sec-title">
								<span class="menu-sec-num">{group.num}</span>
								<span>{group.title}</span>
							</h2>
							<span class="menu-sec-note">{group.items.length} 项</span>
						</div>
						<ul class="touls-rows">
							{group.items.map((tool) => (
								<MenuToolRow tool={tool} />
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>
</ScaffoldLayout>

<style>
	.subpage-title {
		margin: 0;
		font-size: clamp(2rem, 5.2vw, 2.7rem);
		line-height: 1.25;
		font-weight: 520;
	}

	.subpage-lead {
		margin: 0.55rem 0 0;
		color: var(--color-muted);
		font-size: 0.98rem;
	}

	.touls-sections {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2.5rem;
		margin-top: 2rem;
		min-width: 0;
	}

	.touls-sec {
		min-width: 0;
	}

	.touls-rows {
		margin: 0.35rem 0 0;
		padding: 0;
		list-style: none;
	}
</style>
