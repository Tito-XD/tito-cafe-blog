---
import MenuToolRow from '~/components/MenuToolRow.astro';
import { tools } from '~/data/tools';
import ScaffoldLayout from '~/layouts/ScaffoldLayout.astro';
---

<ScaffoldLayout
	title="Touls"
	description="店长写来自用的小工具。"
	currentNav="Touls"
>
	<div class="paper-sheet paper-page touls-page">
		<header class="subpage-head">
			<h1 class="subpage-title">Touls</h1>
			<p class="subpage-lead">店长写来自用的小工具。</p>
		</header>

		<section class="touls-sec" aria-label="小工具列表">
			<div class="menu-sec-head">
				<h2 class="menu-sec-title">
					<span class="menu-sec-num">01</span>
					<span>列表</span>
				</h2>
				<span class="menu-sec-note">类别</span>
			</div>
			<ul class="touls-rows">
				{tools.map((tool) => <MenuToolRow tool={tool} />)}
			</ul>
		</section>
	</div>
</ScaffoldLayout>

<style>
	.subpage-title {
		margin: 0;
		font-size: clamp(2rem, 5.2vw, 2.7rem);
		line-height: 1.25;
		font-weight: 520;
	}

	.subpage-lead {
		margin: 0.5rem 0 0;
		color: var(--color-muted);
		font-size: 0.98rem;
	}

	.touls-sec {
		margin-top: 1.85rem;
		min-width: 0;
	}

	.touls-rows {
		margin: 0.35rem 0 0;
		padding: 0;
		list-style: none;
	}
</style>
