---
import { Picture } from 'astro:assets';
import managerImg from '~/assets/tito_xd-cafe-manager-by-frankuwu.png';
import MenuPostRow from '~/components/MenuPostRow.astro';
import MenuToolRow from '~/components/MenuToolRow.astro';
import { SiteDescription, SiteTitle } from '~/config';
import { friends } from '~/data/friends';
import { tools } from '~/data/tools';
import ScaffoldLayout from '~/layouts/ScaffoldLayout.astro';
import { getPosts } from '~/utils/collection';
import { isAnnualPost } from '~/utils/readingTime';

const allPosts = await getPosts(false, 'desc');
const annualPosts = allPosts.filter((post) => isAnnualPost(post)).slice(0, 2);
const annualIds = new Set(annualPosts.map((post) => post.id));
const recentRegularPosts = allPosts
	.filter((post) => !annualIds.has(post.id))
	.slice(0, 4);

const featuredTools = tools.filter((tool) => tool.featured);

const formatHost = (rawUrl?: string) => {
	if (!rawUrl) {
		return '';
	}
	try {
		return new URL(rawUrl).hostname.replace(/^www\./, '');
	} catch {
		return rawUrl;
	}
};
---

<ScaffoldLayout title={SiteTitle} description={SiteDescription} currentNav="Home">
	<div class="home-layout">
		<aside class="home-counter">
			<div class="home-counter__stage">
				<Picture
					class="home-counter__art"
					src={managerImg}
					formats={['avif', 'webp']}
					alt="店长头头：蓝发灰狼，穿蓝衬衫和深色围裙，胸前别着 Tito 名牌"
					sizes="(max-width: 895px) 12rem, 14.5rem"
					loading="eager"
				/>
			</div>
			<p class="home-counter__credit">
				立绘{' '}
				<a href="https://frankuwu.link/" target="_blank" rel="noopener">
					Frank uwu
				</a>
			</p>
		</aside>

		<div class="home-sheet paper-sheet">
			<section class="home-greet">
				<h1>
					路上辛苦了，
					<br />
					喝点什么？
				</h1>
				<p>我是 Tito_XD，本店的店长，也可以叫我头头。</p>
				<p>
					总归还是生活碎碎念。如果我的寥寥几字也能让你驻足停看，那也不错，谢谢。
				</p>
				<p>欢迎光临，请开心。</p>
			</section>

			<div class="home-menu">
				<!-- 01 文章 -->
				<section class="menu-sec" id="posts" aria-labelledby="sec-posts-h">
					<div class="menu-sec-head">
						<h2 class="menu-sec-title" id="sec-posts-h">
							<span class="menu-sec-num">01</span>
							<span>文章</span>
						</h2>
						<span class="menu-sec-note">读完大约</span>
					</div>

					{
						annualPosts.length > 0 && (
							<div class="annual-box">
								<ul class="menu-list">
									{annualPosts.map((post) => (
										<MenuPostRow post={post} showAnnualBadge={true} />
									))}
								</ul>
							</div>
						)
					}

					<ul class="menu-list menu-list--regular">
						{
							recentRegularPosts.map((post) => (
								<MenuPostRow post={post} showAnnualBadge={false} />
							))
						}
					</ul>

					<p class="menu-sec__more">
						<a href="/blog">全部 {allPosts.length} 篇文章 →</a>
					</p>
				</section>

				<!-- 02 Touls -->
				<section class="menu-sec" id="touls" aria-labelledby="sec-touls-h">
					<div class="menu-sec-head">
						<h2 class="menu-sec-title" id="sec-touls-h">
							<span class="menu-sec-num">02</span>
							<span>Touls</span>
						</h2>
						<span class="menu-sec-note">精选</span>
					</div>

					<ul class="menu-list">
						{featuredTools.map((tool) => <MenuToolRow tool={tool} />)}
					</ul>

					<p class="menu-sec__more">
						<a href="/touls">全部 {tools.length} 项小工具与光标 →</a>
					</p>
				</section>

				<!-- 03 邻座 -->
				<section
					class="menu-sec"
					id="neighbors"
					aria-labelledby="sec-neighbors-h"
				>
					<div class="menu-sec-head">
						<h2 class="menu-sec-title" id="sec-neighbors-h">
							<span class="menu-sec-num">03</span>
							<span>邻座</span>
						</h2>
						<span class="menu-sec-note">{friends.length} 位</span>
					</div>

					<ul class="neighbors-grid">
						{
							friends.map((friend) => {
								const name = friend.id ?? 'Friend';
								const host = formatHost(friend.link);
								return (
									<li>
										<a
											class="neighbor-card"
											href={friend.link}
											target="_blank"
											rel="noopener"
										>
											<span class="neighbor-card__avatar">
												{friend.avatar ? (
													<img
														src={friend.avatar}
														alt=""
														loading="lazy"
														decoding="async"
													/>
												) : (
													<span>{name.slice(0, 1)}</span>
												)}
											</span>
											<span class="neighbor-card__body">
												<span class="neighbor-card__head">
													<span class="neighbor-card__name">{name}</span>
													{host && (
														<span class="neighbor-card__host">{host} ↗</span>
													)}
												</span>
												{friend.bio && (
													<span class="neighbor-card__bio">{friend.bio}</span>
												)}
											</span>
										</a>
									</li>
								);
							})
						}
					</ul>

					<p class="menu-sec__more">
						<a href="/friends">邻座详情与本店名片 →</a>
					</p>
				</section>

				<!-- 04 关于 -->
				<section
					class="menu-sec about-sec"
					id="about"
					aria-labelledby="sec-about-h"
				>
					<div class="menu-sec-head">
						<h2 class="menu-sec-title" id="sec-about-h">
							<span class="menu-sec-num">04</span>
							<span>关于</span>
						</h2>
					</div>
					<div class="about-sec__copy">
						<p>nameless nobody but still exploring this world.</p>
						<p>want to make 21 grams interesting.</p>
						<p>
							lives in Hubei, Wuhan and working as marketing, website
							maintainer.
						</p>
					</div>
					<p class="menu-sec__more">
						<a href="/about">更多关于店长与出没地点 →</a>
					</p>
				</section>
			</div>
		</div>
	</div>
</ScaffoldLayout>

<style>
	.home-layout {
		display: grid;
		gap: 1.5rem;
		padding-block: 0.75rem 2rem;
	}

	.home-counter__stage {
		height: 13.5rem;
		overflow: hidden;
		border-bottom: 2px solid var(--color-text);
	}

	.home-counter :global(picture) {
		display: block;
	}

	.home-counter :global(img),
	.home-counter__art {
		display: block;
		width: 11.5rem;
		height: auto;
		margin-inline: auto;
	}

	.home-counter__credit {
		margin: 0.5rem 0 0;
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		color: var(--color-muted);
		text-align: center;
	}

	.home-sheet {
		min-width: 0;
		padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 4.2vw, 2.85rem);
	}

	.home-greet {
		padding-bottom: 2.25rem;
	}

	.home-greet h1 {
		margin: 0;
		font-size: clamp(2rem, 5.6vw, 3rem);
		line-height: 1.25;
		font-weight: 520;
		text-wrap: balance;
	}

	.home-greet p {
		max-width: 34em;
		margin: 0.7rem 0 0;
		text-wrap: pretty;
	}

	.home-greet h1 + p {
		margin-top: 1.15rem;
	}

	.home-menu {
		display: grid;
		gap: 2.75rem;
		min-width: 0;
	}

	@media (min-width: 56rem) {
		.home-layout {
			grid-template-columns: 14rem minmax(0, 44rem);
			justify-content: center;
			align-items: start;
			column-gap: clamp(2.25rem, 5vw, 3.75rem);
			padding-block: 1.5rem 2.75rem;
		}

		.home-counter {
			position: sticky;
			top: 2rem;
			padding-top: 0.5rem;
		}

		.home-counter__stage {
			height: auto;
			overflow: visible;
			border-bottom: 0;
		}

		.home-counter :global(img),
		.home-counter__art {
			width: 100%;
		}
	}

	.menu-sec {
		scroll-margin-top: 1.5rem;
	}

	.menu-list {
		margin: 0.4rem 0 0;
		padding: 0;
		list-style: none;
	}

	.annual-box {
		margin-top: 0.9rem;
		padding: 0.2rem 0.9rem;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-surface-raised);
	}

	.annual-box .menu-list {
		margin-top: 0;
	}

	.menu-list--regular {
		margin-top: 0.5rem;
	}

	.menu-sec__more {
		margin: 0.9rem 0 0;
		font-size: 0.95rem;
	}

	/* 03 Neighbors compact cards */
	.neighbors-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
		gap: 0.6rem;
		margin: 0.95rem 0 0;
		padding: 0;
		list-style: none;
	}

	.neighbor-card {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		height: 100%;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-surface-raised);
		color: var(--color-text);
		text-decoration: none;
		transition:
			border-color var(--motion-gentle),
			background var(--motion-gentle);
	}

	.neighbor-card__avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: var(--color-surface-2);
		font-family: var(--font-ui);
		font-size: 0.85rem;
		color: var(--color-muted);
	}

	.neighbor-card__avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.neighbor-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.08rem;
		min-width: 0;
		flex: 1;
	}

	.neighbor-card__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.45rem;
	}

	.neighbor-card__name {
		font-size: 1.02rem;
		font-weight: 520;
		line-height: 1.35;
		transition: color var(--motion-gentle);
	}

	.neighbor-card__host {
		font-family: var(--font-ui);
		font-size: 0.74rem;
		color: var(--color-muted);
		white-space: nowrap;
	}

	.neighbor-card__bio {
		color: var(--color-muted);
		font-size: 0.84rem;
		line-height: 1.45;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (hover: hover) and (pointer: fine) {
		.neighbor-card:hover {
			border-color: var(--color-leather);
		}

		.neighbor-card:hover .neighbor-card__name {
			color: var(--color-accent);
		}
	}

	.about-sec__copy {
		margin-top: 0.85rem;
	}

	.about-sec__copy p {
		margin: 0;
	}

	.about-sec__copy p + p {
		margin-top: 0.35rem;
	}
</style>
